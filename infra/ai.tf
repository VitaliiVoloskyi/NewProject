# Paste an agenda. The agenda-parser Lambda, outside the VPC, behind a public function URL: it
# checks the caller's Cognito token, sends the pasted text to Claude on Amazon Bedrock and
# returns a suggested agenda as JSON. It has no database access and writes nothing; the browser
# saves the agenda through the API. Plus a monthly budget alarm. Was infra/ai.yml (Lab 6).

resource "aws_cloudwatch_log_group" "parser" {
  name              = "/${var.project_name}/agenda-parser"
  retention_in_days = 14
}

# The name was generated by CloudFormation and is kept so the role is imported, not replaced.
resource "aws_iam_role" "parser" {
  name = "${var.project_name}-ai-ParserRole-RPVwxWnQ0hqP"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "lambda.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
}

# CloudWatch Logs only: no VPC, no database, no S3.
resource "aws_iam_role_policy_attachment" "parser_logs" {
  role       = aws_iam_role.parser.name
  policy_arn = "arn:${local.partition}:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
}

resource "aws_iam_role_policy" "parser" {
  name = "call-claude"
  role = aws_iam_role.parser.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      # The Anthropic Messages API on Bedrock (bedrock-mantle). Any model for now: narrowing the
      # resource is a discussion question of Lab 6 (see ADR 0006).
      {
        Effect   = "Allow"
        Action   = "bedrock-mantle:CreateInference"
        Resource = "*"
      },
      # The Converse API (bedrock-runtime), for models served through an inference profile, such
      # as us.anthropic.claude-opus-4-5-... (see parser_model).
      {
        Effect   = "Allow"
        Action   = "bedrock:InvokeModel"
        Resource = "*"
      },
    ]
  })
}

# The backend's code with a plain handler, like the report builder. No vpc_config: it needs no
# database and reaches Bedrock and Cognito's keys over the internet, with no NAT.
resource "aws_lambda_function" "parser" {
  function_name = "${var.project_name}-agenda-parser"
  description   = "Suggests a structured agenda from pasted text (Claude on Bedrock)"
  package_type  = "Image"
  image_uri     = local.initial_image_uri
  architectures = ["x86_64"]
  memory_size   = 512
  # A parse takes 2-8 s; one retry after an invalid answer doubles that.
  timeout = 30
  role    = aws_iam_role.parser.arn

  image_config {
    command = ["app.ai.agenda_lambda.handler"]
  }

  logging_config {
    log_group = aws_cloudwatch_log_group.parser.name
    # JSON lines: the fields passed with extra= (model, tokens, cost, ...) become keys.
    log_format            = "JSON"
    application_log_level = "INFO"
    system_log_level      = "INFO"
  }

  environment {
    variables = {
      PARSER_MODEL         = var.parser_model
      COGNITO_USER_POOL_ID = aws_cognito_user_pool.main.id
      COGNITO_CLIENT_ID    = aws_cognito_user_pool_client.web.id
    }
  }

  # The code travels the application road (make deploy-backend, CI), like the builder's.
  lifecycle {
    ignore_changes = [image_uri]
  }

  depends_on = [aws_iam_role_policy_attachment.parser_logs]
}

resource "aws_lambda_function_url" "parser" {
  function_name      = aws_lambda_function.parser.function_name
  authorization_type = "NONE"

  # The URL answers the browser's preflight itself; the handler adds no CORS headers.
  cors {
    allow_origins = var.app_urls
    allow_methods = ["POST"]
    allow_headers = ["authorization", "content-type"]
    max_age       = 3600
  }
}

# Public, like the API: anyone may reach it, the handler rejects calls without a valid Cognito
# token. A public function URL needs both permissions. The statement IDs were generated by
# CloudFormation and are kept so the permissions are imported.
resource "aws_lambda_permission" "parser_url" {
  statement_id           = "${var.project_name}-ai-ParserUrlPermission-ackg6RO4Inu9"
  function_name          = aws_lambda_function.parser.function_name
  action                 = "lambda:InvokeFunctionUrl"
  principal              = "*"
  function_url_auth_type = "NONE"
}

resource "aws_lambda_permission" "parser_invoke" {
  statement_id             = "${var.project_name}-ai-ParserInvokePermission-4B9HGGpfafaO"
  function_name            = aws_lambda_function.parser.function_name
  action                   = "lambda:InvokeFunction"
  principal                = "*"
  invoked_via_function_url = true
}

# The cheapest insurance: an email when the month's actual (or forecast) cost passes the limit.
resource "aws_budgets_budget" "monthly" {
  count = var.budget_email != "" ? 1 : 0

  name         = "${var.project_name}-monthly"
  budget_type  = "COST"
  time_unit    = "MONTHLY"
  limit_amount = format("%.1f", var.budget_limit_usd)
  limit_unit   = "USD"

  dynamic "notification" {
    for_each = ["ACTUAL", "FORECASTED"]

    content {
      notification_type          = notification.value
      comparison_operator        = "GREATER_THAN"
      threshold                  = 100
      threshold_type             = "PERCENTAGE"
      subscriber_email_addresses = [var.budget_email]
    }
  }
}
