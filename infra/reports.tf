# Weekly meetings report. EventBridge Scheduler (and make report-now) put a request on an SQS
# queue; the report-builder Lambda, in the backend's VPC, reads the database and writes
# reports/<week>.csv to S3 through a gateway endpoint. The new object triggers the report-mailer
# Lambda, outside the VPC, which emails the file through SES. Neither function calls the other.
# Was infra/reports.yaml (Lab 5).

locals {
  reports_bucket = "${var.project_name}-reports-${local.account_id}"
  recipients     = [for a in split(",", var.report_recipients) : trimspace(a) if trimspace(a) != ""]
  sender         = var.report_sender_domain != "" ? "reports@${var.report_sender_domain}" : local.recipients[0]
}

# --------------------------------------------------------------------- Storage
# Bucket, notification and the mailer's permission are three resources here, each pointing at
# the one before it, so CloudFormation's circular dependency (and its explicit-name trick) is gone.
resource "aws_s3_bucket" "reports" {
  bucket = local.reports_bucket

  # Every report ever sent is in here. A destroy or a replacing change fails the plan.
  lifecycle {
    prevent_destroy = true
  }
}

resource "aws_s3_bucket_public_access_block" "reports" {
  bucket                  = aws_s3_bucket.reports.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_ownership_controls" "reports" {
  bucket = aws_s3_bucket.reports.id

  rule {
    object_ownership = "BucketOwnerEnforced"
  }
}

resource "aws_s3_bucket_lifecycle_configuration" "reports" {
  bucket = aws_s3_bucket.reports.id

  rule {
    id     = "delete-old-reports"
    status = "Enabled"

    filter {
      prefix = "reports/"
    }

    expiration {
      days = 90
    }
  }
}

# Trigger 3: a new report is an event. The mailer listens; the builder does not know it.
resource "aws_s3_bucket_notification" "reports" {
  bucket = aws_s3_bucket.reports.id

  lambda_function {
    lambda_function_arn = aws_lambda_function.mailer.arn
    events              = ["s3:ObjectCreated:*"]
    filter_prefix       = "reports/"
    filter_suffix       = ".csv"
  }

  # S3 tests the permission when the notification is saved.
  depends_on = [aws_lambda_permission.mailer_s3]
}

# The builder has no internet access (no NAT). A gateway endpoint gives its subnets a route to
# S3, free of charge; without it PutObject hangs until the function times out.
resource "aws_vpc_endpoint" "s3" {
  vpc_id            = local.backend["VpcId"]
  vpc_endpoint_type = "Gateway"
  service_name      = "com.amazonaws.${var.region}.s3"
  route_table_ids   = [local.backend["PrivateRouteTableId"]]
}

# ----------------------------------------------------------------------- Queue
resource "aws_sqs_queue" "requests_dlq" {
  name                      = "${var.project_name}-report-requests-dlq"
  message_retention_seconds = 1209600 # 14 days, the maximum: time to notice and redrive
  max_message_size          = 1048576 # 1 MiB, what SQS gives a new queue now
}

# Trigger 2. One entry point for every request (schedule, make report-now, later the API).
resource "aws_sqs_queue" "requests" {
  name = "${var.project_name}-report-requests"
  # 6x the builder's timeout: a message must not reappear while an attempt still runs, or a
  # second builder starts on the same report.
  visibility_timeout_seconds = 360
  max_message_size           = 1048576
  redrive_policy = jsonencode({
    deadLetterTargetArn = aws_sqs_queue.requests_dlq.arn
    maxReceiveCount     = 3
  })
}

# -------------------------------------------------------------------- Schedule
# Role names were generated by CloudFormation. They are kept so the roles are imported, not
# replaced; a new name would mean a new role.
resource "aws_iam_role" "scheduler" {
  name = "${var.project_name}-reports-SchedulerRole-xDFRLHHX92Q9"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "scheduler.amazonaws.com" }
      Action    = "sts:AssumeRole"
      Condition = { StringEquals = { "aws:SourceAccount" = local.account_id } }
    }]
  })
}

resource "aws_iam_role_policy" "scheduler" {
  name = "send-report-requests"
  role = aws_iam_role.scheduler.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = "sqs:SendMessage"
      Resource = aws_sqs_queue.requests.arn
    }]
  })
}

# Trigger 1: a command, BuildWeeklyReport, every Monday at 07:00 Kyiv time. Without the time
# zone the cron runs in UTC and the report arrives at 9 or 10 depending on daylight saving.
resource "aws_scheduler_schedule" "weekly" {
  name                         = "${var.project_name}-weekly-report"
  description                  = "Requests last week's meetings report"
  schedule_expression          = var.report_schedule
  schedule_expression_timezone = var.report_timezone
  state                        = "ENABLED"

  flexible_time_window {
    mode = "OFF"
  }

  target {
    arn      = aws_sqs_queue.requests.arn
    role_arn = aws_iam_role.scheduler.arn
    # No week: the builder takes the previous full ISO week.
    input = "{\"week\": null, \"source\": \"schedule\"}"
  }
}

# --------------------------------------------------------------------- Builder
resource "aws_cloudwatch_log_group" "builder" {
  name              = "/${var.project_name}/report-builder"
  retention_in_days = 14
}

resource "aws_iam_role" "builder" {
  name = "${var.project_name}-reports-BuilderRole-lIxoR1ggkb9K"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "lambda.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
}

# Network interfaces in the VPC + CloudWatch Logs.
resource "aws_iam_role_policy_attachment" "builder_vpc" {
  role       = aws_iam_role.builder.name
  policy_arn = "arn:${local.partition}:iam::aws:policy/service-role/AWSLambdaVPCAccessExecutionRole"
}

# The Lambda service polls the queue on the function's behalf: the function itself never
# connects to SQS, which is why it works without a NAT.
resource "aws_iam_role_policy_attachment" "builder_sqs" {
  role       = aws_iam_role.builder.name
  policy_arn = "arn:${local.partition}:iam::aws:policy/service-role/AWSLambdaSQSQueueExecutionRole"
}

resource "aws_iam_role_policy" "builder" {
  name = "write-reports"
  role = aws_iam_role.builder.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = "s3:PutObject"
      Resource = "${aws_s3_bucket.reports.arn}/reports/*"
    }]
  })
}

# The backend's code and models, built without the web adapter, with a plain handler.
resource "aws_lambda_function" "builder" {
  function_name = "${var.project_name}-report-builder"
  description   = "Builds reports/<week>.csv from the database"
  package_type  = "Image"
  image_uri     = local.initial_image_uri
  architectures = ["x86_64"]
  memory_size   = 512
  # Leaves room for a cold start and a slow database; the queue's visibility timeout is 6x.
  timeout = 60
  role    = aws_iam_role.builder.arn

  image_config {
    command = ["app.reports.lambda_handler.handler"]
  }

  vpc_config {
    subnet_ids         = split(",", local.backend["PrivateSubnetIds"])
    security_group_ids = [local.backend["FunctionSecurityGroupId"]]
  }

  logging_config {
    log_group = aws_cloudwatch_log_group.builder.name
    # JSON lines: the fields passed with extra= (trigger, week, ...) become searchable keys.
    log_format            = "JSON"
    application_log_level = "INFO"
    system_log_level      = "INFO"
  }

  environment {
    variables = {
      # The same database as the API, with the same connection string.
      DATABASE_URL      = data.aws_lambda_function.api.environment[0].variables["DATABASE_URL"]
      REPORTS_BUCKET    = aws_s3_bucket.reports.bucket
      REPORT_TIMEZONE   = var.report_timezone
      REPORT_BREAK_WEEK = var.report_break_week
    }
  }

  # The code travels the application road: make deploy-backend (CI) pushes a new image and
  # points the function at it. Terraform owns everything else.
  lifecycle {
    ignore_changes = [image_uri]
  }

  # Without the route to S3, the first report hangs until it times out.
  depends_on = [aws_vpc_endpoint.s3, aws_iam_role_policy_attachment.builder_vpc]
}

resource "aws_lambda_event_source_mapping" "builder" {
  function_name    = aws_lambda_function.builder.arn
  event_source_arn = aws_sqs_queue.requests.arn
  batch_size       = 1

  # Backpressure: at most two builders at once, whatever lands in the queue, so a burst of
  # requests waits instead of using up the database's connections or Lambda's concurrency.
  scaling_config {
    maximum_concurrency = 2
  }

  depends_on = [aws_iam_role_policy_attachment.builder_sqs]
}

# ---------------------------------------------------------------------- Mailer
resource "aws_cloudwatch_log_group" "mailer" {
  name              = "/${var.project_name}/report-mailer"
  retention_in_days = 14
}

# Read-only on reports/: a function triggered by uploads to a prefix must never upload there, or
# it triggers itself forever.
resource "aws_iam_role" "mailer" {
  name = "${var.project_name}-reports-MailerRole-tBDGYhKKeA3p"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "lambda.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "mailer_logs" {
  role       = aws_iam_role.mailer.name
  policy_arn = "arn:${local.partition}:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
}

resource "aws_iam_role_policy" "mailer" {
  name = "read-reports-send-email"
  role = aws_iam_role.mailer.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect   = "Allow"
        Action   = "s3:GetObject"
        Resource = "${aws_s3_bucket.reports.arn}/reports/*"
      },
      # In the sandbox SES checks the sender's and the recipients' identities.
      {
        Effect   = "Allow"
        Action   = ["ses:SendEmail", "ses:SendRawEmail"]
        Resource = "arn:${local.partition}:ses:${var.region}:${local.account_id}:identity/*"
      },
    ]
  })
}

data "archive_file" "mailer" {
  type        = "zip"
  source_file = "${path.module}/functions/report-mailer/index.py"
  output_path = "${path.module}/.build/report-mailer.zip"
}

# Outside the VPC: normal internet access to SES, and no way to reach the database.
resource "aws_lambda_function" "mailer" {
  function_name    = "${var.project_name}-report-mailer"
  description      = "Emails each new reports/*.csv through SES"
  runtime          = "python3.14"
  handler          = "index.handler"
  filename         = data.archive_file.mailer.output_path
  source_code_hash = data.archive_file.mailer.output_base64sha256
  architectures    = ["x86_64"]
  memory_size      = 128
  timeout          = 30
  role             = aws_iam_role.mailer.arn

  logging_config {
    log_group             = aws_cloudwatch_log_group.mailer.name
    log_format            = "JSON"
    application_log_level = "INFO"
    system_log_level      = "INFO"
  }

  environment {
    variables = {
      SENDER     = var.report_sender_domain != "" ? "Meetings reports <reports@${var.report_sender_domain}>" : local.recipients[0]
      RECIPIENTS = var.report_recipients
    }
  }
}

# Only S3 events from this account's reports bucket may invoke the mailer. The statement ID was
# generated by CloudFormation and is kept so the permission is imported.
resource "aws_lambda_permission" "mailer_s3" {
  statement_id   = "${var.project_name}-reports-MailerS3Permission-4Umy85d2Mbk8"
  function_name  = aws_lambda_function.mailer.function_name
  action         = "lambda:InvokeFunction"
  principal      = "s3.amazonaws.com"
  source_arn     = aws_s3_bucket.reports.arn
  source_account = local.account_id
}

# ------------------------------------------------------------------------- SES
# Verified once the three DKIM CNAMEs (outputs) exist at the domain's DNS provider. Recipient
# addresses are verified by make verify-recipients (one identity per address).
resource "aws_sesv2_email_identity" "domain" {
  count          = var.report_sender_domain != "" ? 1 : 0
  email_identity = var.report_sender_domain
}

resource "aws_route53_record" "dkim" {
  count   = var.report_sender_domain != "" && var.hosted_zone_id != "" ? 3 : 0
  zone_id = var.hosted_zone_id
  name    = "${aws_sesv2_email_identity.domain[0].dkim_signing_attributes[0].tokens[count.index]}._domainkey.${var.report_sender_domain}"
  type    = "CNAME"
  ttl     = 1800
  records = ["${aws_sesv2_email_identity.domain[0].dkim_signing_attributes[0].tokens[count.index]}.dkim.amazonses.com"]
}
