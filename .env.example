POSTGRES_USER=meetings
POSTGRES_PASSWORD=meetings
POSTGRES_DB=meetings
# Host port for Postgres (change if 5432 is already in use)
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://meetings:meetings@db:5432/meetings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Auth (Cognito) ---
# Filled in by `make auth-env` from Terraform's outputs (public IDs, not secrets). Local runs use the same
# user pool as AWS. The backend only accepts ID tokens from this pool and app client.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
COGNITO_GOOGLE_ENABLED=false
# Google sign-in is Terraform now: google_client_id in infra/terraform.tfvars, and the secret as
# the sensitive variable google_client_secret of the HCP Terraform workspace (docs/DEPLOY.md, 4.2).

# --- AWS deployment (make deploy-backend / deploy-frontend) ---
# No access keys here, ever. Run `aws configure` once (keys of your IAM user, not root);
# the scripts use that profile. Set AWS_PROFILE to use a named profile instead of default.
AWS_PROFILE=
AWS_REGION=us-east-1
# Prefix for all AWS resource and stack names; every resource is tagged PROJECT_NAME=<this>
PROJECT_NAME=spry
# Extra origins allowed to call the deployed API, comma-separated. The CloudFront address
# and the custom domain are added automatically.
CORS_ORIGINS_AWS=
# Backend Lambda memory in MB (CPU scales with it; 400,000 GB-seconds/month are free)
LAMBDA_MEMORY=512

# --- Custom domain (optional: make add-domain, after make deploy) ---
# Host name for the frontend, e.g. app.example.com. Leave empty for the *.cloudfront.net address.
DOMAIN_NAME=
# Optional Route 53 hosted zone id of DOMAIN_NAME (e.g. Z0123456789ABC). If set, the DNS records
# are created for you; otherwise make add-domain prints the records to add at your DNS provider.
HOSTED_ZONE_ID=

# --- Weekly meetings report (infra/reports.tf, applied by HCP Terraform) ---
# The schedule, sender domain and break week are report_* in infra/terraform.tfvars; the
# recipients are the workspace variable report_recipients. Here only for make verify-recipients,
# which sends each address its SES verification link (the SES sandbox needs it).
REPORTS_RECIPIENTS=

# --- Paste an agenda (Claude on Amazon Bedrock, us-east-1) ---
# Bedrock model ID for make parse / llm-hello on your laptop (the deployed parser uses
# parser_model in infra/terraform.tfvars). A plain anthropic.* ID goes through the Messages API
# (anthropic.claude-opus-5-5, anthropic.claude-haiku-5-5); an inference profile through the
# Converse API (us.anthropic.claude-opus-4-5-20251101-v1:0, us.anthropic.claude-haiku-4-5-20251001-v1:0).
PARSER_MODEL=anthropic.claude-opus-5-5
# The parser's URL for `make dev-frontend` (written by make auth-env). Deploy builds set it
# themselves. Empty: Paste an agenda is hidden.
VITE_PARSER_URL=
# The $5 budget alarm's address is the workspace variable budget_email (infra/ai.tf).

# --- CI/CD (make deploy-ci) ---
# owner/name of your GitHub repository: the only one allowed to deploy via OIDC.
GITHUB_REPO=
