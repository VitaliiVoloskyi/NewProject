# Cloud SQL for PostgreSQL, the smallest tier. Unlike Aurora Serverless it never pauses: it bills
# $0.0105 an hour while running. Stop it with `make gcp-db-stop` when nobody uses it (the 10 GB
# disk still bills, $1.70 a month); `terraform destroy` in this workspace deletes it.
resource "google_sql_database_instance" "main" {
  name             = "${var.project_name}-db"
  database_version = "POSTGRES_17"
  region           = var.region

  # Lab: destroy has to remove everything. In production this would be true.
  deletion_protection = false

  settings {
    # PostgreSQL 16+ defaults to Enterprise Plus, which has no shared-core tiers.
    edition           = "ENTERPRISE"
    tier              = var.database_tier
    availability_type = "ZONAL"
    disk_type         = "PD_SSD"
    disk_size         = 10
    disk_autoresize   = false

    # Running or stopped is an operating decision (make gcp-db-stop / gcp-db-start), not
    # configuration: see the lifecycle block.
    activation_policy = "ALWAYS"

    # A public IP with no authorized networks: nobody can connect to it directly. Cloud Run and
    # the Cloud SQL Auth Proxy connect through the Cloud SQL Admin API with IAM, encrypted.
    ip_configuration {
      ipv4_enabled = true
      ssl_mode     = "ENCRYPTED_ONLY"
    }

    backup_configuration {
      enabled = false # lab data; nothing to restore
    }

    user_labels = {
      project    = var.project_name
      managed-by = "terraform"
    }
  }

  lifecycle {
    ignore_changes = [settings[0].activation_policy]
  }

  depends_on = [google_project_service.this]
}

resource "google_sql_database" "spry" {
  name     = "meetings"
  instance = google_sql_database_instance.main.name
}

# Generated by Terraform, never typed and never in the repository. It is in the workspace's
# state (encrypted in HCP Terraform) and in Secret Manager, where the API reads it.
resource "random_password" "db" {
  length  = 32
  special = false
}

resource "google_sql_user" "api" {
  name     = "meetings"
  instance = google_sql_database_instance.main.name
  password = random_password.db.result
}

# The whole connection string, so the API's settings (DATABASE_URL) stay as they are on AWS.
# asyncpg reaches the instance through the Unix socket Cloud Run mounts at /cloudsql/<connection name>.
resource "google_secret_manager_secret" "database_url" {
  secret_id = "${var.project_name}-database-url"

  replication {
    auto {}
  }

  depends_on = [google_project_service.this]
}

resource "google_secret_manager_secret_version" "database_url" {
  secret = google_secret_manager_secret.database_url.id
  secret_data = format(
    "postgresql+asyncpg://%s:%s@/%s?host=/cloudsql/%s",
    google_sql_user.api.name,
    random_password.db.result,
    google_sql_database.spry.name,
    google_sql_database_instance.main.connection_name,
  )
}

# Only the API's service account can read it, and only this secret.
resource "google_secret_manager_secret_iam_member" "api_reads_database_url" {
  secret_id = google_secret_manager_secret.database_url.id
  role      = "roles/secretmanager.secretAccessor"
  member    = data.google_service_account.api.member
}
